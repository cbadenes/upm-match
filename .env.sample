# UPM Match - Environment variables
#
# Copy this file to .env and fill in the real values.
# The .env file is never committed (listed in .gitignore).
#
# Generate AIRFLOW_FERNET_KEY:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Generate AIRFLOW_SECRET_KEY:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
#
# Variable legend:
#   [REQUIRED]         Must be set, no default exists or placeholder is insecure.
#   [REQUIRED: cloud]  Only needed when using the cloud LLM/embedding path.
#   [OPTIONAL]         Has a sensible default, override only when needed.
#   [DOCKER ONLY]      Set in docker-compose.yaml as a hardcoded override, listed here for local (non-Docker) development only.
# =============================================================================


# MinIO (object storage)
# Consumed by: docker-compose.yaml (minio service) + dbs/minio.py

MINIO_ROOT_USER=minio_admin           # [REQUIRED]
MINIO_ROOT_PASSWORD=change_me         # [REQUIRED]
MINIO_BUCKET_NAME=bucket_name         # [REQUIRED]  bucket used by all pipeline phases

# Local-dev overrides (docker-compose sets these to container names automatically):
# MINIO_HOST=localhost                 # [DOCKER ONLY]  default: localhost
# MINIO_PORT=9000                      # [DOCKER ONLY]  default: 9000


# Memgraph (graph database)
# Consumed by: docker-compose.yaml (memgraph service) + dbs/graph/memgraph.py

MEMGRAPH_USERNAME=memgraph            # [REQUIRED]
MEMGRAPH_PASSWORD=change_me           # [REQUIRED]
MEMGRAPH_ENCRYPTED=false              # [OPTIONAL], the other posible value is true
# Local-dev overrides:
# MEMGRAPH_HOST=localhost              # [DOCKER ONLY]  default: localhost
# MEMGRAPH_PORT=7687                   # [DOCKER ONLY]  default: 7687


# Qdrant (vector database)
# Consumed by: 
#  - docker-compose.yaml (qdrant service)
#  - dbs/vector/qdrant.py
#  - 06_create_summaries.py
QDRANT_API_KEY=change_me              # [REQUIRED]

# Local-dev overrides:
# QDRANT_HOST=localhost                # [DOCKER ONLY]  default: localhost
# QDRANT_PORT=6333                     # [DOCKER ONLY]  default: 6333


# Ollama (local LLM / embeddings)
# Consumed by: 
#  - app/agent.py, app/search.py
#  - 06_create_summaries.py
# docker-compose sets OLLAMA_HOST=tfm_ollama and OLLAMA_PORT=11434 automatically.
OLLAMA_MODEL=qwen2.5:7b-instruct            # [OPTIONAL]  keyword-extraction agent (app/)
OLLAMA_SUMMARY_MODEL=qwen2.5:7b-instruct    # [OPTIONAL]  rolling-biography phase (06)
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe  # [OPTIONAL]  dense embeddings (06 + app/)

# Local-dev overrides:
# OLLAMA_HOST=http://localhost:11434   # [DOCKER ONLY]  default: derived from OLLAMA_PORT
# OLLAMA_PORT=11434                    # [DOCKER ONLY]  default: 11434


# Airflow
# Consumed by: docker-compose.yaml (airflow-init, airflow-webserver, airflow-scheduler)
AIRFLOW_ADMIN_PASSWORD=change_me                                # [REQUIRED]
AIRFLOW_FERNET_KEY=change_me_generate_with_cryptography_fernet  # [REQUIRED]
AIRFLOW_SECRET_KEY=change_me_generate_with_secrets_token_hex    # [REQUIRED]
AIRFLOW_ADMIN_EMAIL=admin@upm.es                                # [OPTIONAL]  default: admin@upm.es
