# UPM Match - Environment variables
#
# Copy this file to .env and fill in the real values.
# The .env file is never committed (listed in .gitignore).
#
# Generate AIRFLOW_FERNET_KEY:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Generate AIRFLOW_SECRET_KEY:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
#
# Variable legend:
#   [REQUIRED]         Must be set, no default exists or placeholder is insecure.
#   [REQUIRED: cloud]  Only needed when using the cloud LLM/embedding path.
#   [OPTIONAL]         Has a sensible default, override only when needed.
#   [DOCKER ONLY]      Set in docker-compose.yaml as a hardcoded override, listed here for local (non-Docker) development only.
# =============================================================================


# Public deployment / reverse-proxy routing (subpath mode)
# The whole stack is served under ONE subpath on ONE host port. 
# In production a host-managed Nginx forwards PUBLIC_BASE_URL -> 127.0.0.1:HOST_PORT.
# Locally there is no host Nginx, so you hit the container Nginx directly on HOST_PORT.
# Consumed by: docker-compose.yaml (nginx, app, lab, airflow) + nginx template + app/__init__.py
APP_BASE_PATH=/upm-match                           # [REQUIRED]  the subpath everything hangs under ("mi_app"); path component of PUBLIC_BASE_URL
HOST_PORT=1234                                     # [REQUIRED]  loopback port the host Nginx forwards to. Keep private, do not publish
PUBLIC_BASE_URL=http://localhost:1234/upm-match    # [REQUIRED]  full external base URL (scheme + host[:port] + APP_BASE_PATH). A production example: https://your-domain.com/upm-match


# MinIO (object storage)
# Consumed by: docker-compose.yaml (minio service) + dbs/minio.py

MINIO_ROOT_USER=minio_admin           # [REQUIRED]
MINIO_ROOT_PASSWORD=change_me         # [REQUIRED]
MINIO_RAW_BUCKET=tfm-raw              # [REQUIRED]  researchers.csv + raw HTMLs (phases 1-3)
MINIO_PROCESSED_BUCKET=tfm-processed  # [REQUIRED]  pdi_<id>.json raw AJAX data (phase 3)
MINIO_CURATED_BUCKET=tfm-curated      # [REQUIRED]  enrichment.json per PDI (phases 4-6)

# Local-dev override (docker-compose sets the host to the service name automatically; the port is MINIO_PORT in the Host-access ports section above)
# MINIO_HOST=localhost                 # [DOCKER ONLY]  default: localhost
MINIO_PORT=9000                        # [OPTIONAL]  host port for MinIO S3 (container: 9000)
MINIO_CONSOLE_PORT=9001                # [OPTIONAL]  host port for MinIO console (container: 9001)


# Memgraph (graph database)
# Consumed by: docker-compose.yaml (memgraph service) + dbs/graph/memgraph.py
MEMGRAPH_USERNAME=memgraph            # [REQUIRED]
MEMGRAPH_PASSWORD=change_me           # [REQUIRED]
MEMGRAPH_ENCRYPTED=false              # [OPTIONAL], the other posible value is true

# Local-dev override (port is MEMGRAPH_PORT in the Host-access ports section above):
# MEMGRAPH_HOST=localhost              # [DOCKER ONLY]  default: localhost
MEMGRAPH_PORT=7687                     # [OPTIONAL]  host port for Memgraph Bolt (container: 7687)


# Qdrant (vector database)
# Consumed by:
#  - docker-compose.yaml (qdrant service)
#  - dbs/vector/qdrant.py
#  - 06_create_summaries.py
QDRANT_API_KEY=change_me              # [REQUIRED]

# Local-dev override (port is QDRANT_PORT in the Host-access ports section above):
# QDRANT_HOST=localhost                # [DOCKER ONLY]  default: localhost
QDRANT_PORT=6333                       # [OPTIONAL]  host port for Qdrant      (container: 6333)
# QDRANT_GRPC_PORT=6334                # [OPTIONAL]  host port for Qdrant gRPC  (container: 6334)
SPARSE_EMBED_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions  # [OPTIONAL]  sparse BM42 model (05 + app/ via dbs/vector/qdrant.py)

# Ollama (local LLM / embeddings)
# Consumed by:
#  - app/agent.py, app/search.py
#  - 06_create_summaries.py
# Ollama runs as a service in this compose (see infra/docker-compose.yaml), on the same network.
OLLAMA_HOST=ollama                           # [REQUIRED]  Ollama service name in the compose network
OLLAMA_PORT=11434                            # [OPTIONAL]  Ollama port (container default: 11434)

OLLAMA_MODEL=qwen2.5:7b-instruct            # [OPTIONAL]  keyword-extraction agent (app/)
OLLAMA_SUMMARY_MODEL=qwen2.5:7b-instruct    # [OPTIONAL]  rolling-biography phase (06)
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe  # [OPTIONAL]  dense embeddings (06 + app/)


# Summaries pipeline (phase 6)
# Consumed by: 06_create_summaries.py
SUMMARY_PUBS_PER_BATCH=10              # [OPTIONAL]  max publications per batch when summarising a year (avoids overflowing the LLM context window)
SUMMARY_MAX_WORKERS=2                  # [OPTIONAL]  parallel workers in phase 6 (Ollama is single-threaded; 2-3 overlaps MinIO I/O with inference)


# Airflow
# Consumed by: docker-compose.yaml (airflow-init, airflow-webserver, airflow-scheduler)
AIRFLOW_ADMIN_PASSWORD=change_me                                # [REQUIRED]
AIRFLOW_FERNET_KEY=change_me_generate_with_cryptography_fernet  # [REQUIRED]
AIRFLOW_SECRET_KEY=change_me_generate_with_secrets_token_hex    # [REQUIRED]
AIRFLOW_ADMIN_EMAIL=admin@upm.es                                # [OPTIONAL]  default: admin@upm.es
